# Copy this file to .env.local and fill in your values (.env.local is git-ignored).
# Find both in the Supabase dashboard under Project Settings > API.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The public "anon" key (or the newer "publishable" key, starting sb_publishable_).
# NEVER put the "service_role" or "secret" key here: everything in VITE_ variables is
# visible to anyone who opens the app.
VITE_SUPABASE_ANON_KEY=
